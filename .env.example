# Copy to .env (or export these) before running in anything but local dev.
# ADMIN_PASSWORD: the single shared password admins type at /login.
ADMIN_PASSWORD=changeme
# SECRET_KEY: signs the session cookie. Use a long random value in production,
# e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
SECRET_KEY=dev-insecure-change-me
# DB_PATH: SQLite file location (optional).
DB_PATH=inventory.db
